{
  "name": "aws-superpower-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "tsx scripts/build-corpus.ts",
    "validate": "tsx scripts/validate-content.ts",
    "dev": "npm run content && vite",
    "build": "npm run validate && npm run content && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "eval:retrieval": "npm run content && tsx scripts/eval-retrieval.ts",
    "contrast": "tsx scripts/contrast-check.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "yaml": "2.6.1",
    "zod": "3.23.8"
  }
}
